SourceFolders:
- .

# These are the SDKs that are used by all configurations
Imports:
- ../core_project.yaml
- ../../../../../../sdk/Telemetry/2.1A3/telemetry_2.1A3.yaml

# Settings from the General section, for all configurations
General:
  ConfigurationType: StaticLibrary
  UseOfMfc: false
  IntDir: ../temp/$(ProjectName)/$(Platform)/$(Configuration)/$(PlatformToolset)/
  TargetExt: .lib

# Compiler settings for all configurations
ClCompile:
  EnableEnhancedInstructionSet: StreamingSIMDExtensions2
  PreprocessorDefinitions: 
  # This is to prevent warnings from std::copy
  - _SCL_SECURE_NO_WARNINGS
  - BLUEBUILD
  PrecompiledHeader: NotUsing
  DebugInformationFormat: OldStyle
  WarningLevel: Level3
  TreatWarningAsError: true
  BufferSecurityCheck: false
  AdditionalIncludeDirectories:
  - .
  - ..
  CppExceptions: true
  RuntimeTypeInfo: true
  GenerateDebugInformation: true

# Linker settings for all configurations
Link:
  GenerateDebugInformation: true
  AdditionalDependencies:
  - ws2_32.lib
  - version.lib
  - crypt32.lib
  - iphlpapi.lib
  - psapi.lib

  DelayLoadDLLs:
  - psapi.dll

BaseConfigurations:
  Debug:
    ClCompile:
      PreprocessorDefinitions:
      - _DEBUG
      Optimization: Disabled
      RuntimeLibrary: MultiThreadedDebugDLL

  Release:
    ClCompile:
      Optimization: MaxSpeed
      RuntimeLibrary: MultiThreadedDLL

  Static:
    ClCompile:
      PreprocessorDefinitions:
      - BLUEBUILD_STATIC

  Lua:
    Imports:
    - ../lua/uses_Lua.yaml
    General:
      OutDir: ../../autobuild/BlueExposure/lua/$(Platform)/$(PlatformToolset)/

  Android:
    General:
      AndroidTargetAPI: android-14
      TargetExt: .a
      AndroidStlType: gnustl_static
      AndroidArch: armv7-a
    ClCompile:
      AdditionalOptions: -std=c++0x

Configurations:
  Debug|Win32,x64:
    Imports:
    - ../stackless/stackless.yaml
    BaseConfigurations:
    - Debug
    General: 
      OutDir: ../../autobuild/BlueExposure/exefile/$(Platform)/$(PlatformToolset)/
      TargetName: BlueExposure_d

  DebugLua|ORBIS:
    BaseConfigurations:
    - Debug
    - Lua
    General: 
      TargetName: libBlueExposure_d
      TargetExt: .a
    ClCompile:
      AdditionalOptions:
      - -Wno-unused-function

  DebugLua|Win32,x64:
    BaseConfigurations:
    - Debug
    - Lua
    General: 
      TargetName: BlueExposure_d

  Release|Win32,x64:
    Imports:
    - ../stackless/stackless.yaml
    BaseConfigurations:
    - Release
    General:
      OutDir: ../../autobuild/BlueExposure/exefile/$(Platform)/$(PlatformToolset)/
      TargetName: BlueExposure

  Release_26|Win32,x64:
    Imports:
    - ../../../../../../sdk/python/Python_2.6.yaml
    BaseConfigurations:
    - Release
    General:
      OutDir: ../../autobuild/BlueExposure/python_26/$(Platform)/$(PlatformToolset)/
      TargetName: BlueExposure

  Release_27|Win32,x64,Mac32,Mac64,Linux64:
    Imports:
    - ../../../../../../sdk/python/Python_2.7.yaml
    BaseConfigurations:
    - Release
    General:
      OutDir: ../../autobuild/BlueExposure/python_27/$(Platform)/$(PlatformToolset)/
      TargetName: BlueExposure

  DebugStatic|Win32,x64:
    Imports:
    - ../stackless/stackless.yaml
    BaseConfigurations:
    - Debug
    - Static
    General: 
      OutDir: ../../autobuild/BlueExposure/exefile/$(Platform)/$(PlatformToolset)/
      TargetName: BlueExposureStatic_d

  ReleaseStatic|Win32,x64:
    Imports:
    - ../stackless/stackless.yaml
    BaseConfigurations:
    - Release
    - Static
    General:
      OutDir: ../../autobuild/BlueExposure/exefile/$(Platform)/$(PlatformToolset)/
      TargetName: BlueExposureStatic

  ReleaseStatic_26|Win32,x64:
    Imports:
    - ../../../../../../sdk/python/Python_2.6.yaml
    BaseConfigurations:
    - Release
    - Static
    General:
      OutDir: ../../autobuild/BlueExposure/python_26/$(Platform)/$(PlatformToolset)/
      TargetName: BlueExposureStatic

  ReleaseStatic_27|Win32,x64:
    Imports:
    - ../../../../../../sdk/python/Python_2.7.yaml
    BaseConfigurations:
    - Release
    - Static
    General:
      OutDir: ../../autobuild/BlueExposure/python_27/$(Platform)/$(PlatformToolset)/
      TargetName: BlueExposureStatic

  DebugStatic_Lua|Win32,x64:
    BaseConfigurations:
    - Debug
    - Static
    - Lua
    General: 
      TargetName: BlueExposureStatic_d

  DebugStatic_Lua|ORBIS:
    BaseConfigurations:
    - Debug
    - Static
    - Lua
    General: 
      TargetName: libBlueExposureStatic_d
      TargetExt: .a
    ClCompile:
      AdditionalOptions:
      - -Wno-unused-function

  DebugStatic_Lua|Tegra-Android:
    BaseConfigurations:
    - Debug
    - Static
    - Lua
    - Android
    General: 
      TargetName: libBlueExposureStatic_d

  ReleaseStatic_Lua|Tegra-Android:
    BaseConfigurations:
    - Release
    - Static
    - Lua
    - Android
    General: 
      TargetName: libBlueExposureStatic
